# Base URL da API Orca (auth e demais endpoints). Documentação: docs/auth-login.md
# Em dev, se VITE_USE_API_PROXY não for "false", as chamadas usam /api (proxy Vite) para evitar CORS.
VITE_API_URL=http://localhost:3000

# Sentry (runtime)
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=false
# verbose = máxima visibilidade | normal = só erros críticos
VITE_SENTRY_VISIBILITY_MODE=verbose

# Sentry (build/deploy — não usar prefixo VITE_)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
APP_VERSION=
